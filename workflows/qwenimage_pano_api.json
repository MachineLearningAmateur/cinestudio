{
 "unet": {
  "class_type": "UnetLoaderGGUF",
  "inputs": {
   "unet_name": "qwen-image-2512-Q8_0.gguf"
  },
  "_meta": {
   "title": "Qwen-Image-2512 (GGUF Q8, full model)"
  }
 },
 "lora": {
  "class_type": "LoraLoaderModelOnly",
  "inputs": {
   "model": [
    "unet",
    0
   ],
   "lora_name": "qwen-360-diffusion-2512-int8-bf16-v2.safetensors",
   "strength_model": 1.0
  },
  "_meta": {
   "title": "360 panorama LoRA (ProGamerGov, MIT)"
  }
 },
 "ms": {
  "class_type": "ModelSamplingAuraFlow",
  "inputs": {
   "model": [
    "lora",
    0
   ],
   "shift": 3.1
  },
  "_meta": {
   "title": "shift 3.1 (official template)"
  }
 },
 "clip": {
  "class_type": "CLIPLoader",
  "inputs": {
   "clip_name": "qwen_2.5_vl_7b_fp8_scaled.safetensors",
   "type": "qwen_image",
   "device": "default"
  }
 },
 "pos": {
  "class_type": "CLIPTextEncode",
  "inputs": {
   "clip": [
    "clip",
    0
   ],
   "text": "PROMPT"
  }
 },
 "neg": {
  "class_type": "CLIPTextEncode",
  "inputs": {
   "clip": [
    "clip",
    0
   ],
   "text": "NEGATIVE"
  }
 },
 "lat": {
  "class_type": "EmptySD3LatentImage",
  "inputs": {
   "width": 2048,
   "height": 1024,
   "batch_size": 1
  },
  "_meta": {
   "title": "2:1 (the LoRA's training size)"
  }
 },
 "ks": {
  "class_type": "KSampler",
  "inputs": {
   "model": [
    "ms",
    0
   ],
   "seed": 1,
   "steps": 50,
   "cfg": 4.0,
   "sampler_name": "euler",
   "scheduler": "simple",
   "positive": [
    "pos",
    0
   ],
   "negative": [
    "neg",
    0
   ],
   "latent_image": [
    "lat",
    0
   ],
   "denoise": 1.0
  },
  "_meta": {
   "title": "50 steps, cfg 4 (official template)"
  }
 },
 "vae": {
  "class_type": "VAELoader",
  "inputs": {
   "vae_name": "qwen_image_vae.safetensors"
  }
 },
 "dec": {
  "class_type": "VAEDecode",
  "inputs": {
   "samples": [
    "ks",
    0
   ],
   "vae": [
    "vae",
    0
   ]
  }
 },
 "save": {
  "class_type": "SaveImage",
  "inputs": {
   "images": [
    "dec",
    0
   ],
   "filename_prefix": "cinestudio/pano"
  }
 }
}