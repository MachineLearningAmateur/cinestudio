{
 "ckpt": {
  "class_type": "UNETLoader",
  "inputs": {
   "unet_name": "ltx-2.5-22b-dev-transformer-comfy-int8-convrot.safetensors",
   "weight_dtype": "default"
  },
  "_meta": {
   "title": "LTX-2.5 22B full model (dev transformer)"
  }
 },
 "audio_vae": {
  "class_type": "VAELoader",
  "inputs": {
   "vae_name": "ltx-2.5-audio-vae-bf16.safetensors"
  },
  "_meta": {
   "title": "LTX-2.5 audio VAE"
  }
 },
 "te": {
  "class_type": "CLIPLoader",
  "inputs": {
   "clip_name": "gemma4-12b-with-proj-ltx-2.5-comfy-int8-convrot.safetensors",
   "type": "ltxv",
   "device": "default"
  },
  "_meta": {
   "title": "Gemma 4 12B text encoder (LTX-2.5)"
  }
 },
 "pos": {
  "class_type": "CLIPTextEncode",
  "inputs": {
   "clip": [
    "te",
    0
   ],
   "text": "PROMPT"
  },
  "_meta": {
   "title": "Prompt"
  }
 },
 "neg": {
  "class_type": "CLIPTextEncode",
  "inputs": {
   "clip": [
    "te",
    0
   ],
   "text": "NEGATIVE"
  },
  "_meta": {
   "title": "Negative prompt"
  }
 },
 "cond": {
  "class_type": "LTXVConditioning",
  "inputs": {
   "positive": [
    "pos",
    0
   ],
   "negative": [
    "neg",
    0
   ],
   "frame_rate": 24.0
  },
  "_meta": {
   "title": "Frame-rate conditioning"
  }
 },
 "lora_style": {
  "class_type": "LoraLoaderModelOnly",
  "inputs": {
   "model": [
    "ckpt",
    0
   ],
   "lora_name": "STYLE_LORA.safetensors",
   "strength_model": 0.8
  },
  "_meta": {
   "title": "Style LoRA (required here)"
  }
 },
 "sheet_load": {
  "class_type": "LoadImage",
  "inputs": {
   "image": "REFERENCE.png"
  },
  "_meta": {
   "title": "Reference sheet"
  }
 },
 "sheet_fit": {
  "class_type": "ResizeAndPadImage",
  "inputs": {
   "image": [
    "sheet_load",
    0
   ],
   "target_width": 1536,
   "target_height": 896,
   "padding_color": "black",
   "interpolation": "lanczos"
  },
  "_meta": {
   "title": "Sheet at clip size"
  }
 },
 "lat": {
  "class_type": "EmptyLTXVLatentVideo",
  "inputs": {
   "width": 1536,
   "height": 896,
   "length": 9,
   "batch_size": 1
  },
  "_meta": {
   "title": "Still clip latent"
  }
 },
 "i2v": {
  "class_type": "LTXVImgToVideoInplace",
  "inputs": {
   "vae": [
    "vvae",
    0
   ],
   "image": [
    "sheet_fit",
    0
   ],
   "latent": [
    "lat",
    0
   ],
   "strength": 0.5,
   "bypass": false
  },
  "_meta": {
   "title": "Sheet as first frame (strength = how much of the original stays)"
  }
 },
 "alat": {
  "class_type": "LTXVEmptyLatentAudio",
  "inputs": {
   "frames_number": 9,
   "frame_rate": 24.0,
   "batch_size": 1,
   "audio_vae": [
    "audio_vae",
    0
   ]
  },
  "_meta": {
   "title": "Audio latent (unused)"
  }
 },
 "av": {
  "class_type": "LTXVConcatAVLatent",
  "inputs": {
   "video_latent": [
    "i2v",
    0
   ],
   "audio_latent": [
    "alat",
    0
   ]
  },
  "_meta": {
   "title": "Video + audio"
  }
 },
 "ks": {
  "class_type": "SamplerCustomAdvanced",
  "inputs": {
   "noise": [
    "noise1",
    0
   ],
   "guider": [
    "guider1",
    0
   ],
   "sampler": [
    "sampler1",
    0
   ],
   "sigmas": [
    "sigmas1",
    0
   ],
   "latent_image": [
    "av",
    0
   ]
  }
 },
 "sep": {
  "class_type": "LTXVSeparateAVLatent",
  "inputs": {
   "av_latent": [
    "ks",
    0
   ]
  },
  "_meta": {
   "title": "Split"
  }
 },
 "vdec": {
  "class_type": "VAEDecodeTiled",
  "inputs": {
   "samples": [
    "sep",
    0
   ],
   "vae": [
    "vvae",
    0
   ],
   "tile_size": 512,
   "overlap": 64,
   "temporal_size": 64,
   "temporal_overlap": 16
  },
  "_meta": {
   "title": "Decode"
  }
 },
 "pick_first": {
  "class_type": "ImageFromBatch",
  "inputs": {
   "image": [
    "vdec",
    0
   ],
   "batch_index": 0,
   "length": 1
  },
  "_meta": {
   "title": "Frame 0"
  }
 },
 "pick_last": {
  "class_type": "ImageFromBatch",
  "inputs": {
   "image": [
    "vdec",
    0
   ],
   "batch_index": 8,
   "length": 1
  },
  "_meta": {
   "title": "Last frame"
  }
 },
 "save_first": {
  "class_type": "SaveImage",
  "inputs": {
   "images": [
    "pick_first",
    0
   ],
   "filename_prefix": "cinestudio/sheet"
  },
  "_meta": {
   "title": "Styled sheet (frame 0)"
  }
 },
 "save_last": {
  "class_type": "SaveImage",
  "inputs": {
   "images": [
    "pick_last",
    0
   ],
   "filename_prefix": "cinestudio/sheet_last"
  },
  "_meta": {
   "title": "Styled sheet (last frame)"
  }
 },
 "noise1": {
  "class_type": "RandomNoise",
  "inputs": {
   "noise_seed": 333
  }
 },
 "sampler1": {
  "class_type": "KSamplerSelect",
  "inputs": {
   "sampler_name": "euler"
  }
 },
 "sigmas1": {
  "class_type": "LTXVScheduler",
  "inputs": {
   "steps": 30,
   "max_shift": 2.05,
   "base_shift": 0.95,
   "stretch": true,
   "terminal": 0.1,
   "latent": [
    "i2v",
    0
   ]
  }
 },
 "gpv1": {
  "class_type": "GuiderParameters",
  "inputs": {
   "modality": "VIDEO",
   "cfg": 3.0,
   "stg": 1.0,
   "perturb_attn": true,
   "rescale": 0.7,
   "modality_scale": 3.0,
   "skip_step": 0,
   "cross_attn": true
  },
  "_meta": {
   "title": "video guidance (cfg, STG, rescale 0.7)"
  }
 },
 "gpa1": {
  "class_type": "GuiderParameters",
  "inputs": {
   "modality": "AUDIO",
   "cfg": 7.0,
   "stg": 1.0,
   "perturb_attn": true,
   "rescale": 0.7,
   "modality_scale": 3.0,
   "skip_step": 0,
   "cross_attn": true,
   "parameters": [
    "gpv1",
    0
   ]
  },
  "_meta": {
   "title": "audio guidance (cfg, STG, rescale 0.7)"
  }
 },
 "guider1": {
  "class_type": "MultimodalGuider",
  "inputs": {
   "model": [
    "lora_style",
    0
   ],
   "positive": [
    "cond",
    0
   ],
   "negative": [
    "cond",
    1
   ],
   "parameters": [
    "gpa1",
    0
   ],
   "skip_blocks": "28"
  },
  "_meta": {
   "title": "multimodal guider (rescaled)"
  }
 },
 "vvae": {
  "class_type": "VAELoader",
  "inputs": {
   "vae_name": "ltx-2.5-video-vae-bf16.safetensors"
  },
  "_meta": {
   "title": "LTX-2.5 video VAE"
  }
 }
}