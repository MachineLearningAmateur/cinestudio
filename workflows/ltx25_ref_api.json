{
 "ckpt": {
  "class_type": "UNETLoader",
  "inputs": {
   "unet_name": "ltx-2.5-22b-distilled-transformer-comfy-int8-convrot.safetensors",
   "weight_dtype": "default"
  },
  "_meta": {
   "title": "LTX-2.5 22B distilled transformer"
  }
 },
 "audio_vae": {
  "class_type": "VAELoader",
  "inputs": {
   "vae_name": "ltx-2.5-audio-vae-bf16.safetensors"
  },
  "_meta": {
   "title": "LTX-2.5 audio VAE"
  }
 },
 "te": {
  "class_type": "CLIPLoader",
  "inputs": {
   "clip_name": "gemma4-12b-with-proj-ltx-2.5-comfy-int8-convrot.safetensors",
   "type": "ltxv",
   "device": "default"
  },
  "_meta": {
   "title": "Gemma 4 12B text encoder (LTX-2.5)"
  }
 },
 "lora": {
  "class_type": "LoraLoaderModelOnly",
  "inputs": {
   "model": [
    "ckpt",
    0
   ],
   "lora_name": "ltx-2.3-22b-ic-lora-union-control-ref0.5.safetensors",
   "strength_model": 1.0
  },
  "_meta": {
   "title": "IC-LoRA union control (canny / depth / pose)"
  }
 },
 "icp": {
  "class_type": "GetICLoRAParameters",
  "inputs": {
   "iclora_model": [
    "lora",
    0
   ]
  },
  "_meta": {
   "title": "IC-LoRA parameters"
  }
 },
 "pos": {
  "class_type": "CLIPTextEncode",
  "inputs": {
   "clip": [
    "te",
    0
   ],
   "text": "PROMPT"
  },
  "_meta": {
   "title": "Prompt"
  }
 },
 "neg": {
  "class_type": "CLIPTextEncode",
  "inputs": {
   "clip": [
    "te",
    0
   ],
   "text": "NEGATIVE"
  },
  "_meta": {
   "title": "Negative prompt"
  }
 },
 "cond": {
  "class_type": "LTXVConditioning",
  "inputs": {
   "positive": [
    "pos",
    0
   ],
   "negative": [
    "neg",
    0
   ],
   "frame_rate": 24.0
  },
  "_meta": {
   "title": "Frame-rate conditioning"
  }
 },
 "ctl_load": {
  "class_type": "LoadVideo",
  "inputs": {
   "file": "CONTROL.mp4"
  },
  "_meta": {
   "title": "Control video (Blender pass, generation size)"
  }
 },
 "ctl_frames": {
  "class_type": "GetVideoComponents",
  "inputs": {
   "video": [
    "ctl_load",
    0
   ]
  },
  "_meta": {
   "title": "Control frames"
  }
 },
 "first": {
  "class_type": "GetVideoComponents",
  "inputs": {
   "video": [
    "first_load",
    0
   ]
  },
  "_meta": {
   "title": "First frames as images"
  }
 },
 "lat": {
  "class_type": "EmptyLTXVLatentVideo",
  "inputs": {
   "width": 1024,
   "height": 576,
   "length": 121,
   "batch_size": 1
  },
  "_meta": {
   "title": "Video latent (size, frames)"
  }
 },
 "i2v": {
  "class_type": "LTXVImgToVideoInplace",
  "inputs": {
   "vae": [
    "vvae",
    0
   ],
   "image": [
    "first",
    0
   ],
   "latent": [
    "lat",
    0
   ],
   "strength": 1.0,
   "bypass": true
  },
  "_meta": {
   "title": "Pin the first frame (bypass = no first frame)"
  }
 },
 "guide": {
  "class_type": "LTXVAddGuide",
  "inputs": {
   "positive": [
    "ref_guide",
    0
   ],
   "negative": [
    "ref_guide",
    1
   ],
   "vae": [
    "vvae",
    0
   ],
   "latent": [
    "ref_guide",
    2
   ],
   "image": [
    "ctl_frames",
    0
   ],
   "frame_idx": 0,
   "strength": 1.0,
   "iclora_parameters": [
    "icp",
    0
   ]
  },
  "_meta": {
   "title": "Control guide (pose / set, whole clip)"
  }
 },
 "alat": {
  "class_type": "LTXVEmptyLatentAudio",
  "inputs": {
   "frames_number": 121,
   "frame_rate": 24.0,
   "batch_size": 1,
   "audio_vae": [
    "audio_vae",
    0
   ]
  },
  "_meta": {
   "title": "Audio latent"
  }
 },
 "av": {
  "class_type": "LTXVConcatAVLatent",
  "inputs": {
   "video_latent": [
    "guide",
    2
   ],
   "audio_latent": [
    "alat",
    0
   ]
  },
  "_meta": {
   "title": "Video + audio latent"
  }
 },
 "ks": {
  "class_type": "KSampler",
  "inputs": {
   "model": [
    "lora_style",
    0
   ],
   "seed": 333,
   "steps": 8,
   "cfg": 1.0,
   "sampler_name": "euler_ancestral",
   "scheduler": "linear_quadratic",
   "positive": [
    "guide",
    0
   ],
   "negative": [
    "guide",
    1
   ],
   "latent_image": [
    "av",
    0
   ],
   "denoise": 1.0
  },
  "_meta": {
   "title": "Sampler (distilled: 8 steps, cfg 1)"
  }
 },
 "sep": {
  "class_type": "LTXVSeparateAVLatent",
  "inputs": {
   "av_latent": [
    "ks",
    0
   ]
  },
  "_meta": {
   "title": "Split video / audio"
  }
 },
 "crop": {
  "class_type": "LTXVCropGuides",
  "inputs": {
   "positive": [
    "guide",
    0
   ],
   "negative": [
    "guide",
    1
   ],
   "latent": [
    "sep",
    0
   ]
  },
  "_meta": {
   "title": "Remove guide frames"
  }
 },
 "vdec": {
  "class_type": "VAEDecodeTiled",
  "inputs": {
   "samples": [
    "crop",
    2
   ],
   "vae": [
    "vvae",
    0
   ],
   "tile_size": 512,
   "overlap": 64,
   "temporal_size": 64,
   "temporal_overlap": 16
  },
  "_meta": {
   "title": "Video decode (tiled)"
  }
 },
 "adec": {
  "class_type": "LTXVAudioVAEDecode",
  "inputs": {
   "samples": [
    "sep",
    1
   ],
   "audio_vae": [
    "audio_vae",
    0
   ]
  },
  "_meta": {
   "title": "Audio decode"
  }
 },
 "mk": {
  "class_type": "CreateVideo",
  "inputs": {
   "images": [
    "vdec",
    0
   ],
   "audio": [
    "adec",
    0
   ],
   "fps": 24.0
  },
  "_meta": {
   "title": "Create video"
  }
 },
 "save": {
  "class_type": "SaveVideo",
  "inputs": {
   "video": [
    "mk",
    0
   ],
   "filename_prefix": "cinestudio/clip",
   "format": "auto",
   "format.codec": "auto",
   "codec": "auto"
  },
  "_meta": {
   "title": "Save MP4"
  }
 },
 "lora_ing": {
  "class_type": "LoraLoaderModelOnly",
  "inputs": {
   "model": [
    "lora",
    0
   ],
   "lora_name": "ltx-2.5-22b-ic-lora-ingredients-0.9.safetensors",
   "strength_model": 1.0
  },
  "_meta": {
   "title": "IC-LoRA Ingredients (reference sheet: your character)"
  }
 },
 "icp_ing": {
  "class_type": "GetICLoRAParameters",
  "inputs": {
   "iclora_model": [
    "lora_ing",
    0
   ]
  },
  "_meta": {
   "title": "Ingredients parameters"
  }
 },
 "ref_load": {
  "class_type": "LoadImage",
  "inputs": {
   "image": "REFERENCE.png"
  },
  "_meta": {
   "title": "Reference sheet (your character)"
  }
 },
 "ref_fit": {
  "class_type": "ResizeAndPadImage",
  "inputs": {
   "image": [
    "ref_load",
    0
   ],
   "target_width": 1280,
   "target_height": 704,
   "padding_color": "black",
   "interpolation": "lanczos"
  },
  "_meta": {
   "title": "Reference at the video size"
  }
 },
 "ref_video": {
  "class_type": "RepeatImageBatch",
  "inputs": {
   "image": [
    "ref_fit",
    0
   ],
   "amount": 121
  },
  "_meta": {
   "title": "Reference as a still video (clip length)"
  }
 },
 "ref_guide": {
  "class_type": "LTXVAddGuide",
  "inputs": {
   "positive": [
    "cond",
    0
   ],
   "negative": [
    "cond",
    1
   ],
   "vae": [
    "vvae",
    0
   ],
   "latent": [
    "i2v",
    0
   ],
   "image": [
    "ref_video",
    0
   ],
   "frame_idx": 0,
   "strength": 1.0,
   "iclora_parameters": [
    "icp_ing",
    0
   ]
  },
  "_meta": {
   "title": "Reference guide (identity)"
  }
 },
 "lora_style": {
  "class_type": "LoraLoaderModelOnly",
  "inputs": {
   "model": [
    "lora_ing",
    0
   ],
   "lora_name": "STYLE_LORA.safetensors",
   "strength_model": 0.8
  },
  "_meta": {
   "title": "Style LoRA (optional; removed when no style_lora is given)"
  }
 },
 "first_load": {
  "class_type": "LoadVideo",
  "inputs": {
   "file": "FIRST.mp4"
  },
  "_meta": {
   "title": "First frames (the previous clip's last frames, or one first frame)"
  }
 },
 "vvae": {
  "class_type": "VAELoader",
  "inputs": {
   "vae_name": "ltx-2.5-video-vae-bf16.safetensors"
  },
  "_meta": {
   "title": "LTX-2.5 video VAE"
  }
 }
}