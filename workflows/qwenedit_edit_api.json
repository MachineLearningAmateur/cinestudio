{
 "unet": {
  "class_type": "UNETLoader",
  "inputs": {
   "unet_name": "qwen_image_edit_2511_int8_convrot.safetensors",
   "weight_dtype": "default"
  },
  "_meta": {
   "title": "Qwen-Image-Edit-2511"
  }
 },
 "ms": {
  "class_type": "ModelSamplingAuraFlow",
  "inputs": {
   "model": [
    "unet",
    0
   ],
   "shift": 3.1
  },
  "_meta": {
   "title": "Model sampling (template: shift 3.1)"
  }
 },
 "cfgnorm": {
  "class_type": "CFGNorm",
  "inputs": {
   "model": [
    "ms",
    0
   ],
   "strength": 1.0
  },
  "_meta": {
   "title": "CFG norm"
  }
 },
 "lora_fast": {
  "class_type": "LoraLoaderModelOnly",
  "inputs": {
   "model": [
    "cfgnorm",
    0
   ],
   "lora_name": "Qwen-Image-Edit-2511-Lightning-4steps-V1.0-bf16.safetensors",
   "strength_model": 1.0
  },
  "_meta": {
   "title": "Lightning 4-step LoRA (optional: speed)"
  }
 },
 "clip": {
  "class_type": "CLIPLoader",
  "inputs": {
   "clip_name": "qwen_2.5_vl_7b_fp8_scaled.safetensors",
   "type": "qwen_image",
   "device": "default"
  },
  "_meta": {
   "title": "Qwen2.5-VL 7B"
  }
 },
 "vae": {
  "class_type": "VAELoader",
  "inputs": {
   "vae_name": "qwen_image_vae.safetensors"
  },
  "_meta": {
   "title": "VAE"
  }
 },
 "img": {
  "class_type": "LoadImage",
  "inputs": {
   "image": "FRONT.png"
  },
  "_meta": {
   "title": "Image to change (image 1)"
  }
 },
 "scale": {
  "class_type": "FluxKontextImageScale",
  "inputs": {
   "image": [
    "img",
    0
   ]
  },
  "_meta": {
   "title": "Scale to a supported size"
  }
 },
 "pos_txt": {
  "class_type": "TextEncodeQwenImageEditPlus",
  "inputs": {
   "clip": [
    "clip",
    0
   ],
   "prompt": "INSTRUCTION",
   "vae": [
    "vae",
    0
   ],
   "image1": [
    "scale",
    0
   ],
   "image2": [
    "ref_scale",
    0
   ]
  },
  "_meta": {
   "title": "Instruction"
  }
 },
 "neg_txt": {
  "class_type": "TextEncodeQwenImageEditPlus",
  "inputs": {
   "clip": [
    "clip",
    0
   ],
   "prompt": "",
   "vae": [
    "vae",
    0
   ],
   "image1": [
    "scale",
    0
   ],
   "image2": [
    "ref_scale",
    0
   ]
  },
  "_meta": {
   "title": "Empty negative"
  }
 },
 "pos": {
  "class_type": "FluxKontextMultiReferenceLatentMethod",
  "inputs": {
   "conditioning": [
    "pos_txt",
    0
   ],
   "reference_latents_method": "index_timestep_zero"
  },
  "_meta": {
   "title": "Reference method"
  }
 },
 "neg": {
  "class_type": "FluxKontextMultiReferenceLatentMethod",
  "inputs": {
   "conditioning": [
    "neg_txt",
    0
   ],
   "reference_latents_method": "index_timestep_zero"
  },
  "_meta": {
   "title": "Reference method (neg)"
  }
 },
 "enc": {
  "class_type": "VAEEncode",
  "inputs": {
   "pixels": [
    "scale",
    0
   ],
   "vae": [
    "vae",
    0
   ]
  },
  "_meta": {
   "title": "Encode the front view"
  }
 },
 "ks": {
  "class_type": "KSampler",
  "inputs": {
   "model": [
    "cfg_tail",
    0
   ],
   "seed": 1,
   "steps": 40,
   "cfg": 3.0,
   "sampler_name": "euler",
   "scheduler": "simple",
   "positive": [
    "pos",
    0
   ],
   "negative": [
    "neg",
    0
   ],
   "latent_image": [
    "enc",
    0
   ],
   "denoise": 1.0
  },
  "_meta": {
   "title": "Sampler (quality: 40 steps cfg 3; fast: 4 steps cfg 1 + Lightning)"
  }
 },
 "dec": {
  "class_type": "VAEDecode",
  "inputs": {
   "samples": [
    "ks",
    0
   ],
   "vae": [
    "vae",
    0
   ]
  },
  "_meta": {
   "title": "Decode"
  }
 },
 "save": {
  "class_type": "SaveImage",
  "inputs": {
   "images": [
    "dec",
    0
   ],
   "filename_prefix": "cinestudio/edit"
  },
  "_meta": {
   "title": "Edited image"
  }
 },
 "ref": {
  "class_type": "LoadImage",
  "inputs": {
   "image": "REFERENCE.png"
  },
  "_meta": {
   "title": "Reference (image 2)"
  }
 },
 "ref_scale": {
  "class_type": "FluxKontextImageScale",
  "inputs": {
   "image": [
    "ref",
    0
   ]
  },
  "_meta": {
   "title": "Reference size"
  }
 },
 "cfg_tail": {
  "class_type": "CFGOverride",
  "inputs": {
   "model": [
    "lora_fast",
    0
   ],
   "cfg": 1.0,
   "start_percent": 0.65,
   "end_percent": 1.0
  },
  "_meta": {
   "title": "No negative pass in the last 35% of the steps (core CFGOverride; bench 2026-10-24: 1.2x, the same picture)"
  }
 }
}